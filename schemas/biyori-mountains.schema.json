{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biyori-mountains/1",
  "title": "biyori-mountains/1(棚の yamabiyori/mountains.json)",
  "description": "ヤマビヨリ mountain_weather_core.MOUNTAINS を読み出した写し(コードは実行しない)。id は並び順の 1 始まり。",
  "type": "object",
  "required": ["schema", "agent", "source", "count", "mountains"],
  "properties": {
    "schema": {"const": "biyori-mountains/1"},
    "agent": {"const": "yamabiyori"},
    "source": {
      "type": "object",
      "required": ["repo", "commit", "file"],
      "properties": {
        "repo": {"type": "string"},
        "commit": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{40}$"}, {"type": "null"}]},
        "version": {"type": ["string", "null"]},
        "file": {"type": "string"}
      }
    },
    "count": {"type": "integer", "minimum": 1},
    "mountains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "lat", "lon", "elevation_m", "region", "access"],
        "properties": {
          "id": {"type": "string", "pattern": "^m\\d{3}$"},
          "name": {"type": "string", "minLength": 1},
          "lat": {"type": "number", "minimum": -90, "maximum": 90},
          "lon": {"type": "number", "minimum": -180, "maximum": 180},
          "elevation_m": {"type": "number"},
          "region": {"type": ["string", "null"]},
          "access": {"type": ["string", "null"]}
        }
      }
    }
  }
}
